# MCP server configuration
MCP_SERVER_NAME=mcp-marketing-analytics
MCP_PUBLIC_BASE_URL=https://mcp-marketing.vercel.app
# Enable only after the Supabase migration and all secrets below are configured.
MCP_AUTH_REQUIRED=false

# Server-side persistence for multi-tenant OAuth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Google Ads application credentials shared by the service
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_API_VERSION=v25
# Explicitly enable only when you want demo data instead of the real API.
GOOGLE_ADS_MOCK_MODE=false

# Local single-user mode only. Never configure these in multi-tenant production.
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
